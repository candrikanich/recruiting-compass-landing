# Environment Variables for Landing Site

# Deployment Configuration
NUXT_PUBLIC_SITE_URL=https://www.therecruitingcompass.com
NUXT_PUBLIC_APP_URL=https://myrecruitingcompass.com

# Resend — monthly recruiting-dates email signup (hero form)
# Create an Audience in your Resend dashboard and paste its ID here
NUXT_RESEND_API_KEY=
NUXT_RESEND_AUDIENCE_ID=

# PostHog — the project token is committed in nuxt.config.ts (public by design).
# Uncomment only to point a build at a different project. Analytics never run
# under `npm run dev` or on localhost.
# NUXT_PUBLIC_POSTHOG_KEY=